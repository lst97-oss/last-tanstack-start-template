{
  "name": "last-tanstack-start-template",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "LOG_FORMAT=pretty LOG_COLOR=always bunx --bun vite dev --port 3000",
    "build": "bunx --bun vite build",
    "start": "bun scripts/start.ts",
    "db:migrate": "echo 'No migrations yet — add your migration runner here (see src/server/db/).'",
    "db:up": "docker compose up -d postgres",
    "typecheck": "bun check --no-script",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "fmt:staged": "bun fmt --staged",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "smoke": "bun scripts/smoke.ts",
    "generate-routes": "tsr generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shikijs/core": "^4.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-form-start": "1.33.5",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "0.11.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "bun-types": "^1.4.4",
    "consola": "3.4.2",
    "nitro": "^3.0.260903-beta",
    "oxc-transform-react": "0.152.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
