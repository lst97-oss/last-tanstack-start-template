{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/*.json", "!src/styles", "!src/routeTree.gen.ts", "!.agents"]
  },
  "formatter": { "enabled": false },
  "linter": { "enabled": true, "includes": ["src/server/**"], "rules": { "preset": "recommended" } },
  "assist": {
    "enabled": true,
    "includes": ["src/**", "scripts/**", "*.ts"],
    "actions": { "source": { "organizeImports": { "level": "on", "options": { "sortBareImports": false } } } }
  }
}
